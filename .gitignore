# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build outputs ────────────────────────────────────────────
dist/
build/
apps/*/dist/
packages/*/dist/
*.tsbuildinfo

# ── Environment / secrets ────────────────────────────────────
# Real env files are never committed. Ship .env.example instead.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Explicit (belt and braces — the globs above should cover these)
apps/web/.env
apps/customer/.env
apps/api/.dev.vars

# ── Cloudflare ───────────────────────────────────────────────
.wrangler/
apps/api/.wrangler/
.dev.vars.*
!.dev.vars.example

# ── Firebase ─────────────────────────────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log
firestore.indexes.json.bak

# ── Editor / OS ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Vite ─────────────────────────────────────────────────────
.vite/
apps/*/.vite/

# ── Misc ─────────────────────────────────────────────────────
*.local
.eslintcache
.cache/
# ── Browser tests ───────────────────────────────────────────
test-results/
playwright-report/
