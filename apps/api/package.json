{
  "name": "@profjero/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:customer": "esbuild test/customer.e2e.ts --bundle --platform=node --format=esm --target=node20 --outfile=.test-build/customer.e2e.mjs --log-level=warning && node .test-build/customer.e2e.mjs",
    "test:security": "esbuild test/security.e2e.ts --bundle --platform=node --format=esm --target=node20 --outfile=.test-build/security.e2e.mjs --log-level=warning && node .test-build/security.e2e.mjs",
    "test": "npm run test:customer && npm run test:security",
    "test:load": "esbuild test/load.ts --bundle --platform=node --format=esm --target=node20 --outfile=.test-build/load.mjs --log-level=warning && node .test-build/load.mjs",
    "dev:fake": "esbuild test/devServer.ts --bundle --platform=node --format=esm --target=node20 --outfile=.test-build/devServer.mjs --log-level=warning && node .test-build/devServer.mjs"
  },
  "dependencies": {
    "@profjero/shared": "*",
    "hono": "^4.13.8",
    "jose": "^5.9.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.147.0"
  }
}
