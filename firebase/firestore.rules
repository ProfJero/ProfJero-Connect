rules_version = '2';

// ProfJero Connect — Firestore security rules.
//
// Neither web app reads or writes Firestore directly. All data access goes
// through the Cloudflare Worker (apps/api), which authenticates as a
// service account; service-account access bypasses these rules. Browsers
// only use Firebase *Auth*.
//
// So the correct client policy is: deny everything. Any future feature
// that needs direct client access must add a narrow, tested rule here
// (see firebase/test/rules.test.mjs) rather than opening collections.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
